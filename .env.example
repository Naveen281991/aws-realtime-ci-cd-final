# Local development environment variables
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env

# Project
PROJECT_NAME="AWS Enterprise CI/CD FastAPI"
DOMAIN=localhost

# Security (change for anything beyond local testing)
SECRET_KEY=changethis-super-secret-key-for-local-dev-only
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Database
POSTGRES_PASSWORD=your_secure_password
# Email (Mailpit is used automatically via compose.override.yml)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=false
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com

# Optional
SENTRY_DSN=
FRONTEND_HOST=http://localhost:5173
FASTAPI_ENV=development
